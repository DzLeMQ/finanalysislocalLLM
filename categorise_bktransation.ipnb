   "source": [
    "def normalise_transaction(value):\n",
    "    if pd.isna(value):\n",
    "        return \"\"\n",
    "    value = str(value).strip().lower()\n",
    "    value = re.sub(r\"[^a-z]+\", \" \", value)\n",
    "    return re.sub(r\"\\s+\", \" \", value).strip()\n",
    "\n",
    "TransformedDF[\"Transaction\"] = TransformedDF[\"Desc\"].apply(normalise_transaction)\n",
    "TransformedDF[\"Transaction\"] = TransformedDF[\"Transaction\"].str.title()\n",
    "\n",
    "TransformedDF.drop(columns = [\"Desc\"], inplace = True)\n",
    "\n",
    "TransformedDF"
   ]
  },
