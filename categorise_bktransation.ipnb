   "source": [
    "#remove unwanted characters leading each transaction\n",
    "CategoriesDF['Transaction'] = CategoriesDF['Transaction'].str.replace(r'^(\\d+\\.|\\*)\\s+', '', regex=True).str.strip()\n",
    "CategoriesDF['Category']=CategoriesDF['Category'].str.title()\n",
    "CategoriesDF\n"
   ]
  },
