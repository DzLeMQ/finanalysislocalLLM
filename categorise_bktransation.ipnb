     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Generate an arrary of sequence of 10s and append the final boundary index\n",
    "IndexTransList = (\n",
    "    np.append(np.arange(0, len(UniqueTransactions), 10), \n",
    "              len(UniqueTransactions)).tolist()\n",
    ")\n",
    "\n",
    "IndexTransList\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "bfdf6d48",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "ResponseChecks(data=None)"
      ]
     },
     "execution_count": 11,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# Validate response 's format\n",
    "from pydantic import BaseModel, field_validator\n",
    "from typing import List\n",
    "\n",
    "class ResponseChecks(BaseModel):\n",
    "    data: List[str]\n",
    "    @field_validator('data')\n",
    "    def check_length(cls, value):\n",
    "        for item in value:\n",
    "            if len(item) >0:\n",
    "                assert \"-\" in item, f\"Item '{item}' does not contain a hyphen\"\n",
    "#Pass asertion\n",
    "ResponseChecks(data=['Hello World - greeting', 'banana cake - fruit'])\n",
    "                    \n",
    "    "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "c67e7613",
   "metadata": {},
   "outputs": [
