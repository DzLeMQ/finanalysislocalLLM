     ]
    }
   ],
   "source": [
    "def read_data():\n",
    "    TransDF = pd.read_csv('sample.csv')\n",
    "    TransDF['Amount'] = pd.to_numeric(TransDF['Amount'], errors='coerce').fillna(0).astype(int)    \n",
    "    return TransDF\n",
    "\n",
    "TransformedDF = read_data()\n",
    "\n",
    "#make sure the data has the right data type\n",
    "print(TransformedDF.dtypes)"
   ]
  },
