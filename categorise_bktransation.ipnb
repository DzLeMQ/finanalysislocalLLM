   "source": [
    "#merge model output to the source data before doing text cleaning\n",
    "SourceDF = TransformedDF.copy()\n",
    "TestMergeDFs = pd.merge(\n",
    "    SourceDF,\n",
    "    CategoriesDF[[\"Transaction\", \"Category\"]],\n",
    "    on=\"Transaction\",\n",
    "    how=\"left\"\n",
    ")\n",
    "TestMergeDFs"
   ]
  },
