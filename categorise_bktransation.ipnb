   "source": [
    "#Clean up the text in the transaction column to remove leading numbers, asterisks, and extra spaces. \n",
    "# Create a new column JoinKey for merging with the categories dataframe. \n",
    "# Drop duplicates based on JoinKey and standardise the case of JoinKey to title case.\n",
    "CategoriesCopyDF = CategoriesDF.copy()\n",
    "CategoriesCopyDF[\"Transaction\"] = CategoriesCopyDF[\"Transaction\"].fillna(\"\").astype(str).str.strip()\n",
    "CategoriesCopyDF[\"Transaction\"] = CategoriesCopyDF[\"Transaction\"].str.replace(r\"^(\\d+\\.|\\*)\\s+\", \"\", \n",
    "regex=True)\n",
    "\n",
    "CategoriesCopyDF[\"JoinKey\"] = CategoriesCopyDF[\"Transaction\"].apply(normalise_transaction)\n",
    "CategoriesCopyDF = CategoriesCopyDF.drop_duplicates(subset=[\"JoinKey\"], keep=\"first\")\n",
    "CategoriesCopyDF[\"JoinKey\"] = CategoriesCopyDF[\"JoinKey\"].str.title()\n",
    "\n",
    "TransformedDF[\"JoinKey\"] = TransformedDF[\"Transaction\"].apply(normalise_transaction)\n",
    "TransformedDF[\"JoinKey\"] = TransformedDF[\"JoinKey\"].str.title()\n",
    "TransformedDF\n",
    "CategoriesCopyDF\n",
    "\n",
    "CategorisedTrans = pd.merge(\n",
    "    TransformedDF,\n",
    "    CategoriesCopyDF[[\"JoinKey\", \"Category\"]],\n",
    "    on=\"JoinKey\",\n",
    "    how=\"left\"\n",
    ").drop(columns=[\"JoinKey\"])\n",
    "\n",
    "CategorisedTrans[\"Category\"] = CategorisedTrans[\"Category\"].fillna(\"Uncategorised\")\n",
    "CategorisedTrans\n"
   ]
  },
