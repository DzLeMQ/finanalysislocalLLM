   "source": [
    "def regroup_category():\n",
    "    # 2. Define a lookup dictionary\n",
    "    LookupDic = {\n",
    "        \"Food\": \"Dining & Leisure\",\n",
    "        \"Dining\": \"Dining & Leisure\",\n",
    "        \"Entertainment\": \"Dining & Leisure\",\n",
    "        \"Groceries\": \"Supplies & Essentials\",\n",
    "        \"Grocery\": \"Supplies & Essentials\",\n",
    "        \"Shopping\": \"Retails\",\n",
    "        \"Clothing\": \"Retails\",\n",
    "        \"Retail\": \"Retails\",\n",
    "        \"Home\": \"Shopping & Retails\",\n",
    "        \"Utilities\": \"Utility\",\n",
    "        \"Health & Wellness\": \"Health & Wellness\",\n",
    "        \"Health\": \"Health & Wellness\",\n",
    "        \"Travel\": \"Travel & Transport\",\n",
    "        \"Transport\": \"Travel & Transport\"\n",
    "    }\n",
    "    CategorisedTrans['Class'] = CategorisedTrans['Category'].map(LookupDic).fillna(CategorisedTrans['Category'])\n",
    "    return CategorisedTrans\n",
    "\n",
    "CategorisedTrans = regroup_category()\n",
    "CategorisedTrans"
   ]
  },
